# Where the SQLite file lives. Defaults to ./data locally; the Docker image sets /app/data.
# DATA_DIR=

# Port the server listens on (Dokploy routes to this).
PORT=3000

# Read-aloud for the intro story and clues (ElevenLabs). Leave the key empty to turn it off.
ELEVENLABS_API_KEY=
# Optional: any voice from your ElevenLabs voice library (defaults to the premade "George").
ELEVENLABS_VOICE_ID=
# Optional: defaults to eleven_multilingual_v2, which reads Bulgarian.
ELEVENLABS_MODEL_ID=

# Mystery generator (npm run mystery / the /mystery command in Claude Code). Runs locally on your
# Claude Code subscription and uploads the result as a new game to this site.
# MYSTERY_APP_URL=https://mistery.tedraykov.me
# MYSTERY_PROMPT_FILE=prompts/mystery-generator.md
# MYSTERY_MODEL=opus
